<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Foldout text="Foldout" value="true" name="Foldout">
        <ui:VisualElement focusable="false" style="flex-grow: 0; justify-content: space-between; flex-direction: row; align-self: stretch; align-items: flex-start; flex-wrap: nowrap; align-content: flex-start; background-color: rgba(0, 0, 0, 0);">
            <ui:IntegerField label="Min" value="0" binding-path="min" name="MinField" style="flex-direction: column; flex-grow: 1; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); -unity-text-outline-width: 0; -unity-text-outline-color: rgba(0, 0, 0, 0); text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-font-style: normal;"/>
            <uie:ToolbarSpacer style="flex-grow: 0;"/>
            <ui:IntegerField label="Max" value="100" name="MaxField" binding-path="max" style="align-items: stretch; flex-direction: column; justify-content: flex-start; flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:SliderInt label="Value" value="100" high-value="100" picking-mode="Ignore" fill="true" inverted="false" show-input-field="true" name="ValueSlider" binding-path="value"/>
        <ui:Toggle label="Do Overflow" name="OverflowToggle" binding-path="doOverflow" tooltip="If true, the value will wrap around when flowing over/under the bounds instead of clamping"/>
        <ui:Foldout text="Events" value="false">
            <uie:PropertyField binding-path="onValueChange"/>
            <uie:PropertyField binding-path="onValueChangePercent"/>
            <uie:PropertyField binding-path="onOverflow"/>
        </ui:Foldout>
    </ui:Foldout>
</ui:UXML>
